# QEMU-virt variant of grub.cfg, written onto the ESP by qemu-smoke.sh.
#
# Differences from the real-hardware grub.cfg:
#   - console=ttyAMA0 (QEMU -M virt PL011) instead of ttyMSM0, and a
#     louder loglevel.
#   - The rootfs still mounts by PARTUUID probed from the boot disk, so no
#     assumptions about /dev/vda vs /dev/sda.
#
# Both configs now take the DTB from the firmware's EFI configuration table
# and issue no `devicetree` command: AAVMF publishes the virt machine's DTB
# here, the board's EDK2 publishes the qcs6490 board DTB on hardware. This
# used to be the one real behavioural difference between the two files.

load_env

# A/B auto-rollback, same logic as the real grub.cfg (see there for the
# full explanation). Exercised under QEMU too so the smoke test covers
# load_env/save_env on the ESP.
if [ "$validated" != "1" ]; then
    if [ "$booted_once" = "1" ]; then
        if [ "$boot" = "1" ]; then
            set boot=0
        else
            set boot=1
        fi
        set validated=1
        save_env boot validated booted_once
        echo "Slot was not validated after its first boot - falling back!"
    else
        set booted_once=1
        save_env booted_once
    fi
fi

regexp --set=nerves_disk '^\(?([^,]+)' "$root"
if [ -z "$nerves_disk" ]; then
    set nerves_disk=hd0
fi

set nerves_cmdline="console=ttyAMA0,115200 earlycon loglevel=7 rootfstype=squashfs rootwait ro net.ifnames=0"

if [ "$boot" = "1" ]; then
    probe --set=nerves_root_uuid --part-uuid ($nerves_disk,gpt3)
    echo "Booting slot B (root PARTUUID=$nerves_root_uuid)..."
    linux ($nerves_disk,gpt3)/boot/Image root=PARTUUID=$nerves_root_uuid $nerves_cmdline
else
    probe --set=nerves_root_uuid --part-uuid ($nerves_disk,gpt2)
    echo "Booting slot A (root PARTUUID=$nerves_root_uuid)..."
    linux ($nerves_disk,gpt2)/boot/Image root=PARTUUID=$nerves_root_uuid $nerves_cmdline
fi

boot
