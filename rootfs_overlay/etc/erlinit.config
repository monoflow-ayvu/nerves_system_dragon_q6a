# Additional configuration for erlinit
#
# To override the settings in this file, see
# https://hexdocs.pm/nerves/advanced-configuration.html#overriding-erlinit-config-from-mix-config.
#

# Turn on the debug prints
#-v

# Specify where erlinit should send the IEx prompt. Only one may be enabled at
# a time. ttyMSM0 is the Dragon Q6A debug UART (115200 8N1).
-c ttyMSM0

# If more than one tty are available, always warn if the user is looking at the
# wrong one.
--warn-unused-tty

# Use nbtty to improve terminal handling on serial ports.
-s "/usr/bin/nbtty"

# Uncomment to hang the board rather than rebooting when Erlang exits
# NOTE: Do not enable on production boards
#--hang-on-exit

# Enable UTF-8 filename handling in Erlang and custom inet configuration
-e LANG=en_US.UTF-8;LANGUAGE=en;ERL_INETRC=/etc/erl_inetrc

# Hexagon NPU (FastRPC/QAIRT) runtime paths for the BEAM and anything it
# spawns. The DSP-side libraries (fastrpc shell + skels) live under
# /usr/lib/dsp; QNN/QAIRT host libraries are in the default /usr/lib.
# Mirrors /etc/profile.d/qcom-npu-env.sh for interactive shells.
-e DSP_LIBRARY_PATH=/usr/lib/dsp;ADSP_LIBRARY_PATH=/usr/lib/dsp
# ONNX Runtime: `ort` is built with the load-dynamic feature, so it dlopen()s
# libonnxruntime at first use from ORT_DYLIB_PATH instead of linking it. Ours is
# installed by the onnxruntime-qnn package. The QNN execution provider is then
# dlopen()ed by onnxruntime itself from the same directory
# (libonnxruntime_providers_qnn.so), with its QNN backend at
# /usr/lib/libQnnHtp.so from qairt-runtime.
-e ORT_DYLIB_PATH=/usr/lib/libonnxruntime.so

# Enable crash dumps (set ERL_CRASH_DUMP_SECONDS=0 to disable)
-e ERL_CRASH_DUMP=/root/erl_crash.dump;ERL_CRASH_DUMP_SECONDS=5

# Mount the application partition (run "man fstab" for field names)
# NOTE: This must match the location in fwup.conf. /dev/rootdisk0p4 is the
#       erlinit-provided stable symlink to partition 4 of whatever disk the
#       rootfs mounted from.
# Flags: noatime kills residual atime writes (24/7 recording on finite
# NVMe endurance). data=ordered (the default, stated for the reader) and
# the default barrier mode are the two options that protect on the
# frequent power cuts this board sees — do not weaken them. commit=60
# trims journal-commit traffic; a cut loses <=60 s of metadata instead of
# <=5 s, irrelevant next to minutes-long NVR segments. qcom-coldplug.sh
# fsck+remounts with these same options every boot.
-m /dev/rootdisk0p4:/root:ext4:nodev,noatime:data=ordered,commit=60

# Erlang release search path
-r /srv/erlang

# Assign a hostname of the form "nerves-<last 4 chars of the serial number>".
# See /etc/boardid.config for locating the serial number.
-d /usr/bin/boardid
-n nerves-%-.4s

# Start udev, fix up NPU device node permissions and launch cdsprpcd
# before the app.
--pre-run-exec /usr/sbin/qcom-coldplug.sh

# If using shoehorn (https://github.com/nerves-project/shoehorn), start the
# shoehorn OTP release up first. If shoehorn isn't around, erlinit fails back
# to the main OTP release.
--boot shoehorn
