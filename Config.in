# Project-specific packages for the Radxa Dragon Q6A (QCS6490) Nerves system.

menu "Qualcomm Hexagon NPU stack"

comment "Kernel-loaded DSP firmware and DSP-side shell (proprietary blobs)"
source "$NERVES_DEFCONFIG_DIR/package/qcom-dsp-firmware/Config.in"
source "$NERVES_DEFCONFIG_DIR/package/qcom-dsp-shell/Config.in"

comment "FastRPC userspace (built from source)"
source "$NERVES_DEFCONFIG_DIR/package/qcom-fastrpc/Config.in"

comment "QAIRT / QNN runtime (proprietary SDK blobs, local dir)"
source "$NERVES_DEFCONFIG_DIR/package/qairt-runtime/Config.in"

comment "ONNX Runtime + QNN execution provider (for ortex / Rust ort)"
source "$NERVES_DEFCONFIG_DIR/package/onnxruntime-qnn/Config.in"

endmenu

menu "Dragon Q6A connectivity"

comment "AIC8800D80 USB WiFi 6 / Bluetooth (vendor driver + firmware)"
source "$NERVES_DEFCONFIG_DIR/package/aic8800/Config.in"

endmenu

# Turnip note: BR2_PACKAGE_MESA3D_VULKAN_DRIVER_FREEDRENO is native since
# Buildroot 2026.08 (nerves_system_br 1.35.x), selected directly in
# nerves_defconfig. The external-tree symbol + meson wiring that shimmed it
# on Buildroot 2026.05 were removed in the same change that bumped
# nerves_system_br to 1.35.1.
