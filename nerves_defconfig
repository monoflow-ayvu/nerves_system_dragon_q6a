# ccache for both host and target compilation. The dir is inside the
# bind-mounted checkout (/nerves/env/<app> is the repo dir in the Docker
# build runner) because the container's $HOME is ephemeral and the runner
# only passes UID/GID/TERM through — an exported BR2_CCACHE_DIR on the CI
# host never reaches the build. ci.yml caches ./.ccache with actions/cache,
# whose post-job save runs even when the build fails.
BR2_CCACHE=y
BR2_CCACHE_DIR="/nerves/env/nerves_system_dragon_q6a/.ccache"
BR2_CCACHE_INITIAL_SETUP="--max-size=4G"
# Tried before each package's own site: some upstreams rot (x265's bitbucket
# downloads are dead) while the nerves backup mirror 403s what it lacks.
BR2_PRIMARY_SITE="https://sources.buildroot.net"
BR2_BACKUP_SITE="https://dl.nerves-project.org"
BR2_ENABLE_DEBUG=y
BR2_GLOBAL_PATCH_DIR="${BR2_EXTERNAL_NERVES_PATH}/patches ${NERVES_DEFCONFIG_DIR}/patches"
BR2_REPRODUCIBLE=y
BR2_ROOTFS_SKELETON_CUSTOM=y
BR2_ROOTFS_SKELETON_CUSTOM_PATH="${BR2_EXTERNAL_NERVES_PATH}/board/nerves-common/skeleton"
BR2_INIT_NONE=y
BR2_ROOTFS_DEVICE_TABLE="${BR2_EXTERNAL_NERVES_PATH}/board/nerves-common/device_table.txt"
# Dynamic /dev via eudev (udev) — BR2_INIT_NONE has no init, so udevd is
# started by rootfs_overlay/usr/sbin/qcom-coldplug.sh (which also applies
# the fastrpc/dma_heap permission rules and launches cdsprpcd).
BR2_ROOTFS_DEVICE_CREATION_DYNAMIC_EUDEV=y
BR2_ENABLE_LOCALE_WHITELIST="locale-archive"
BR2_GENERATE_LOCALE="en_US.UTF-8"
BR2_ROOTFS_OVERLAY="${BR2_EXTERNAL_NERVES_PATH}/board/nerves-common/rootfs_overlay ${NERVES_DEFCONFIG_DIR}/rootfs_overlay"
BR2_ROOTFS_POST_BUILD_SCRIPT="${NERVES_DEFCONFIG_DIR}/post-build.sh ${BR2_EXTERNAL_NERVES_PATH}/board/nerves-common/post-build.sh"
BR2_ROOTFS_POST_IMAGE_SCRIPT="${NERVES_DEFCONFIG_DIR}/post-createfs.sh"
BR2_LINUX_KERNEL=y
BR2_LINUX_KERNEL_CUSTOM_TARBALL=y
# Frozen tuple (see GOAL.md): radxa/kernel, branch linux-6.18.2 @ 559f4f92 —
# the same tree the proven Yocto system uses (radxa-q6a-yocto pins linux-qcom
# 6.18% and replaces its source with this repo/SHA). Board file
# qcs6490-radxa-dragon-q6a.dts includes sc7280.dtsi, which carries the
# CDSP/ADSP remoteproc + qcom,fastrpc glink nodes (compute-cb context banks,
# SMMU, dma-coherent).
#
# Was Deka-Embedded-Linux/linux-dragon-q6a @ e05c4fa (v6.18 + 31 commits).
# Switched because the Radxa tree carries ~70 board commits that are the
# difference between working and broken rather than polish — notably
# "drm/msm: dp: Delay applying clock defaults until PHY is fully enabled",
# "clk: qcom: gcc-sc7280: Add missing GDSC flags", and PCIe GDSC/runtime-PM
# fixes. It also re-enables qcom,ice (3d40d3a11) together with the matching
# HWKM-v1 driver support (fc1bab211) — take both or neither.
#
# The four Deka-only changes go (q7, decided 2026-07-25). This costs less than
# the porting doc implied: the "doubled shared DMA-buf size" commit (e05c4fae)
# only ever modified qcs6490-radxa-dragon-q6a-DEKA-BOARD.dts, i.e. Deka's own
# carrier board, never the qcs6490-radxa-dragon-q6a we build — so it was never
# active for us. The Deka tree was v6.18.0 plus a point-in-time snapshot of
# Radxa's own enablement work, with four Deka patches on top for a different
# board; radxa/kernel continues that same lineage.
#
# The only Deka patches that touched SHARED drivers, i.e. the real candidates
# if we ever need them: 52a1da01 "fix 4K 30 fps" (dpu_7_2_sc7280.h,
# dp_display.c, dp_panel.c) and 3b0e34ee HDMI-audio hw_params
# (drm_hdmi_audio_helper.c). Check whether radxa/kernel already covers them
# before carrying either in patches/.
#
# USE_ARCH_DEFAULT_CONFIG below stays valid: both trees'
# arch/arm64/configs/defconfig are byte-identical (verified — 44334 bytes,
# md5 58efbd609552b5518213f117160a7691), so the fragment layers on the same
# base either way.
BR2_LINUX_KERNEL_CUSTOM_TARBALL_LOCATION="https://github.com/radxa/kernel/archive/559f4f921a01e5358602153364c618fe2a3e431e.tar.gz"
BR2_LINUX_KERNEL_USE_ARCH_DEFAULT_CONFIG=y
BR2_LINUX_KERNEL_CONFIG_FRAGMENT_FILES="${NERVES_DEFCONFIG_DIR}/linux-dragon-q6a.fragment"
BR2_LINUX_KERNEL_DTS_SUPPORT=y
BR2_LINUX_KERNEL_INTREE_DTS_NAME="qcom/qcs6490-radxa-dragon-q6a"
BR2_LINUX_KERNEL_INSTALL_TARGET=y
BR2_LINUX_KERNEL_NEEDS_HOST_OPENSSL=y
BR2_LINUX_KERNEL_NEEDS_HOST_LIBELF=y
BR2_PACKAGE_BUSYBOX_CONFIG="${BR2_EXTERNAL_NERVES_PATH}/board/nerves-common/busybox.config"
BR2_PACKAGE_BUSYBOX_CONFIG_FRAGMENT_FILES="${NERVES_DEFCONFIG_DIR}/busybox.fragment"
BR2_PACKAGE_LIBMNL=y
BR2_PACKAGE_LIBNL=y
BR2_PACKAGE_E2FSPROGS=y
BR2_PACKAGE_GPTFDISK=y
BR2_PACKAGE_GPTFDISK_SGDISK=y
# BR2_PACKAGE_E2FSPROGS_FSCK is not set
BR2_PACKAGE_CA_CERTIFICATES=y
# BR2_TARGET_ROOTFS_TAR is not set
BR2_TARGET_GRUB2=y
BR2_TARGET_GRUB2_BUILTIN_MODULES_EFI="boot linux fdt ext2 fat squash4 part_gpt part_msdos normal efi_gop loadenv echo test true search configfile regexp probe"
BR2_PACKAGE_HOST_DOSFSTOOLS=y
BR2_NERVES_SYSTEM_NAME="nerves_system_dragon_q6a"
BR2_NERVES_ADDITIONAL_IMAGE_FILES="${NERVES_DEFCONFIG_DIR}/fwup.conf"

# --- Qualcomm Hexagon NPU stack ---
# Kernel-loaded DSP firmware (cdsp.mbn/adsp.mbn) + DSP-side shell binary.
# The cdsp.mbn and fastrpc_shell_unsigned_3 version strings MUST match
# (see GOAL.md frozen tuple).
BR2_PACKAGE_QCOM_DSP_FIRMWARE=y
BR2_PACKAGE_QCOM_DSP_SHELL=y
# FastRPC userspace built from source (libcdsprpc/libadsprpc, cdsprpcd,
# fastrpc_test).
BR2_PACKAGE_QCOM_FASTRPC=y
# QAIRT/QNN runtime blobs (SDK 2.42.0.251225, see blobs/qairt-runtime/README.md)
BR2_PACKAGE_QAIRT_RUNTIME=y
# ONNX Runtime 1.28.0 + QNN execution provider, for ortex/Rust `ort` inference
# on the HTP. The EP is a shared provider that onnxruntime dlopen()s, and its
# QNN backend is qairt-runtime's /usr/lib/libQnnHtp.so.
BR2_PACKAGE_ONNXRUNTIME_QNN=y
# Python 3.14 + numpy, so the upstream onnxruntime / onnxruntime_qnn cp314
# aarch64 wheels can be run as a reference implementation against the Rust
# `ort` path. Buildroot 2026.05 ships exactly 3.14.5, which is the ABI those
# wheels require. flatbuffers and ml-dtypes are onnxruntime's own imports.
# The wheels themselves are NOT vendored: unzip them and drop the tree on the
# device, then run with PYTHONPATH pointing at it (see WORKING_NOTES).
BR2_PACKAGE_PYTHON3=y
BR2_PACKAGE_PYTHON3_ZLIB=y
BR2_PACKAGE_PYTHON3_SSL=y
BR2_PACKAGE_PYTHON3_PYEXPAT=y
BR2_PACKAGE_PYTHON_NUMPY=y
BR2_PACKAGE_PYTHON_FLATBUFFERS=y
BR2_PACKAGE_PYTHON_ML_DTYPES=y
BR2_PACKAGE_NBTTY=y
BR2_PACKAGE_ERLANG_28=y
BR2_PACKAGE_NERVES_CONFIG=y
BR2_PACKAGE_NERVES_CONFIG_ACCEPT_RNG_NOTICE=y

# --- Connectivity: AIC8800D80 USB WiFi 6 + BT (vendor driver pkg) ---
BR2_PACKAGE_AIC8800=y
