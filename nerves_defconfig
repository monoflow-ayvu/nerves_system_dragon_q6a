# --- Video: Venus HW codec (V4L2 M2M) + GStreamer + FFmpeg ---
# Venus (CONFIG_VIDEO_QCOM_VENUS=m + vpu firmware) exposes stateful
# V4L2 decode/encode: gst v4l2* elements and ffmpeg *_v4l2m2m codecs.
# kmssink (plugins-bad) scans out DMA-BUF frames zero-copy; gst-gl is
# skipped on purpose (needs X11/Wayland window system in Buildroot).
BR2_PACKAGE_LIBV4L=y
BR2_PACKAGE_LIBV4L_UTILS=y
BR2_PACKAGE_GSTREAMER1=y
BR2_PACKAGE_GST1_PLUGINS_BASE=y
BR2_PACKAGE_GST1_PLUGINS_BASE_PLUGIN_ALSA=y
BR2_PACKAGE_GST1_PLUGINS_BASE_PLUGIN_APP=y
BR2_PACKAGE_GST1_PLUGINS_BASE_PLUGIN_AUDIOCONVERT=y
BR2_PACKAGE_GST1_PLUGINS_BASE_PLUGIN_AUDIORESAMPLE=y
BR2_PACKAGE_GST1_PLUGINS_BASE_PLUGIN_AUDIOTESTSRC=y
BR2_PACKAGE_GST1_PLUGINS_BASE_PLUGIN_VIDEOTESTSRC=y
BR2_PACKAGE_GST1_PLUGINS_BASE_PLUGIN_PLAYBACK=y
BR2_PACKAGE_GST1_PLUGINS_BASE_PLUGIN_VIDEOCONVERTSCALE=y
BR2_PACKAGE_GST1_PLUGINS_GOOD=y
# jpeg: USB webcams (UVC, kernel side in the fragment) deliver MJPEG
# at higher resolutions; jpegdec pairs with v4l2src.
BR2_PACKAGE_GST1_PLUGINS_GOOD_JPEG=y
BR2_PACKAGE_GST1_PLUGINS_GOOD_PLUGIN_AUDIOPARSERS=y
BR2_PACKAGE_GST1_PLUGINS_GOOD_PLUGIN_ISOMP4=y
BR2_PACKAGE_GST1_PLUGINS_GOOD_PLUGIN_MATROSKA=y
BR2_PACKAGE_GST1_PLUGINS_GOOD_PLUGIN_V4L2=y
BR2_PACKAGE_GST1_PLUGINS_BAD=y
BR2_PACKAGE_GST1_PLUGINS_BAD_PLUGIN_KMS=y
BR2_PACKAGE_GST1_PLUGINS_BAD_PLUGIN_VIDEOPARSERS=y
BR2_PACKAGE_GST1_LIBAV=y
# ffmpeg CLI for offline conversion (codecs/demuxers default "all";
# HW decode/encode via h264_v4l2m2m & friends).
BR2_PACKAGE_FFMPEG=y
BR2_PACKAGE_FFMPEG_GPL=y
BR2_PACKAGE_FFMPEG_SWSCALE=y
BR2_PACKAGE_FFMPEG_FFPROBE=y
# Software encode (VPU encode only works <= 480p today): H.264 + HEVC.
# ffmpeg.mk auto-enables --enable-libx264/--enable-libx265 when these are
# set and FFMPEG_GPL=y.
BR2_PACKAGE_X264=y
BR2_PACKAGE_X265=y
