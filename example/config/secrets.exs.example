# WiFi credentials — TEMPLATE. Copy this to config/secrets.exs and edit it:
#
#     cp config/secrets.exs.example config/secrets.exs
#     $EDITOR config/secrets.exs
#
# config/secrets.exs is gitignored. This .example file IS committed, so the
# shape stays discoverable without ever committing a passphrase.
#
# Note this is NOT a Config script — no `import Config` and no `config :app`
# calls. It evaluates to a plain map, which config/target.exs reads with
# Code.eval_file/1. That keeps every VintageNet structural decision in
# target.exs (reviewable, in git) and leaves only the secret values here.
#
# Credentials are baked into the firmware at build time, which is the point:
# the board joins the network on first boot with no manual setup. It also
# means a .fw built from this file contains your passphrase — don't publish
# firmware images built with real credentials.
#
# Environment variables override this file, which is handy for CI:
#
#     WIFI_SSID=guest WIFI_PSK=hunter2 mix firmware
#
# Open network: set psk to nil (or delete the line) and key_mgmt is set to
# :none automatically.
%{
  ssid: "YOUR_WIFI_SSID",
  psk: "YOUR_WIFI_PASSPHRASE",

  # Two-letter ISO country code for the WiFi regulatory domain. This governs
  # which channels and TX powers are legal, and getting it wrong can mean
  # 5 GHz channels simply never appear. "00" is the conservative world domain.
  regulatory_domain: "00"
}
