_build/
deps/
.nix-mix/
.nix-hex/
*.fw
# …but NOT the Adreno SQE microcode vendored in the firmware blobs — a bare
# `*.fw` silently excluded it from CI checkouts and v0.9.0 shipped without
# qcom/a660_sqe.fw (MSM: "Direct firmware load … failed", no GPU for Turnip).
!blobs/qcom-dsp-firmware/**/*.fw
*.img
# `mix nerves.artifact` drops the packaged system tarball in the repo root.
nerves_system_dragon_q6a-portable-*.tar.gz
# buildroot ccache lives in the checkout so the Docker build container can
# reach it (see nerves_defconfig BR2_CCACHE_DIR); cached by ci.yml.
.ccache/
build*.log
erl_crash.dump
test/work/
*.log
**/*.log
.nerves/
