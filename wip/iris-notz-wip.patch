+	/* Assert the reset to XTSS */
+	writel(BIT(0), core->reg_base + WRAPPER_TZ_XTSS_SW_RESET);
+
+	if (core->fw_mapped_mem_size && core->fw_iommu_domain) {
+		unmapped = iommu_unmap(core->fw_iommu_domain, IRIS_FW_START_ADDR,
+				       core->fw_mapped_mem_size);
+		if (unmapped != core->fw_mapped_mem_size)
+			dev_err(core->dev, "failed to unmap firmware\n");
+		else
+			core->fw_mapped_mem_size = 0;
+	}
+
+	return 0;
+}
