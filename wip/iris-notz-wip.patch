+/* PAS-DBG: temporary instrumented replacement for qcom_mdt_load() that
+ * logs every argument and result of the TZ PIL sequence. DEBUG ONLY.
+ */
+static int iris_mdt_load_dbg(struct iris_core *core, const struct firmware *fw,
+			     const char *fw_name, void *mem_virt,
+			     phys_addr_t mem_phys, size_t res_size)
+{
+	struct device *dev = core->dev;
+	const struct elf32_hdr *ehdr = (const struct elf32_hdr *)fw->data;
+	const struct elf32_phdr *phdrs = (const struct elf32_phdr *)(fw->data + ehdr->e_phoff);
+	phys_addr_t min_addr = PHYS_ADDR_MAX, max_addr = 0;
+	bool relocate = false;
+	size_t md_len = 0;
+	void *metadata;
+	int ret, i;
+
+	for (i = 0; i < ehdr->e_phnum; i++) {
+		const struct elf32_phdr *phdr = &phdrs[i];
+
+		if (phdr->p_type != PT_LOAD || !phdr->p_memsz)
+			continue;
+		if (phdr->p_flags & QCOM_MDT_RELOCATABLE)
+			relocate = true;
+		if (phdr->p_paddr < min_addr)
+			min_addr = phdr->p_paddr;
+		if (phdr->p_paddr + phdr->p_memsz > max_addr)
+			max_addr = ALIGN(phdr->p_paddr + phdr->p_memsz, SZ_4K);
+	}
+
+	metadata = qcom_mdt_read_metadata(fw, &md_len, fw_name, dev);
+	if (IS_ERR(metadata)) {
+		ret = PTR_ERR(metadata);
+		dev_err(dev, "PASDBG %s: read_metadata ret=%d\n", fw_name, ret);
+		return ret;
+	}
+
+	dev_info(dev, "PASDBG %s: fwsize=%zu mdlen=%zu crc=%08x reloc=%d min=%pa max=%pa mem_phys=%pa res=%zu pasid=%d\n",
+		 fw_name, fw->size, md_len, crc32_le(0, metadata, md_len),
+		 relocate, &min_addr, &max_addr, &mem_phys, res_size, IRIS_PAS_ID);
+
+	dev_info(dev, "PASDBG: pas_supported(9)=%d supported(0)=%d\n",
+		 qcom_scm_pas_supported(IRIS_PAS_ID), qcom_scm_pas_supported(0));
+
+	ret = qcom_scm_pas_init_image(IRIS_PAS_ID, metadata, md_len, NULL);
+	dev_info(dev, "PASDBG %s: init_image ret=%d\n", fw_name, ret);
+	kfree(metadata);
+	if (ret)
+		return ret;
+
+	if (relocate) {
+		ret = qcom_scm_pas_mem_setup(IRIS_PAS_ID, mem_phys, max_addr - min_addr);
+		dev_info(dev, "PASDBG %s: mem_setup ret=%d size=%pa\n",
+			 fw_name, ret, &(phys_addr_t){max_addr - min_addr});
+		if (ret)
+			return ret;
+	}
+
+	ret = qcom_mdt_load_no_init(dev, fw, fw_name, mem_virt, mem_phys, res_size, NULL);
+	dev_info(dev, "PASDBG %s: load_no_init ret=%d\n", fw_name, ret);
+
+	return ret;
+}
