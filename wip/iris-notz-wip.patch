+void iris_vpu_reset_cpu_no_tz(struct iris_core *core)
+{
+	u32 fw_size = core->fw_mapped_mem_size;
+
+	writel(0, core->reg_base + WRAPPER_TZ_FW_START_ADDR);
+	writel(fw_size, core->reg_base + WRAPPER_TZ_FW_END_ADDR);
+	writel(0, core->reg_base + WRAPPER_TZ_CPA_START_ADDR);
+	writel(fw_size, core->reg_base + WRAPPER_TZ_CPA_END_ADDR);
+	writel(fw_size, core->reg_base + WRAPPER_TZ_NONPIX_START_ADDR);
+	writel(fw_size, core->reg_base + WRAPPER_TZ_NONPIX_END_ADDR);
+
+	/* Bring XTSS out of reset */
+	writel(0, core->reg_base + WRAPPER_TZ_XTSS_SW_RESET);
+}
+
+static int iris_fw_boot_no_tz(struct iris_core *core)
+{
+	int ret;
+
+	if (!core->fw_dev)
+		return -EPROBE_DEFER;
+
+	core->fw_mapped_mem_size = core->fw_mem_size;
+
+	ret = iommu_map(core->fw_iommu_domain, IRIS_FW_START_ADDR,
+			core->fw_mem_phys, core->fw_mem_size,
+			IOMMU_READ | IOMMU_WRITE | IOMMU_PRIV, GFP_KERNEL);
+	if (ret) {
+		dev_err(core->dev, "could not map video firmware region\n");
+		return ret;
+	}
+
+	iris_vpu_reset_cpu_no_tz(core);
+
+	return 0;
+}
