+/* SPDX-License-Identifier: GPL-2.0 */
+/*
+ * 6.18 vendor-tree backport shims for the 7.3-era iris driver.
+ * Force-included via ccflags-y in this directory's Makefile.
+ */
+#ifndef __IRIS_618_COMPAT_H
+#define __IRIS_618_COMPAT_H
+
+#include <linux/slab.h>
+#include <linux/videodev2.h>
+#include <linux/soc/qcom/ubwc.h>
+
+/* 7.x typed-alloc helper (include/linux/slab.h upstream) */
+#ifndef kzalloc_obj
+#define kzalloc_obj(P, ...) kzalloc(sizeof(P), GFP_KERNEL)
+#endif
+
+/* uapi added after 6.18 */
+#ifndef V4L2_PIX_FMT_AV1
+#define V4L2_PIX_FMT_AV1 v4l2_fourcc('A', 'V', '0', '1')
+#endif
+
+/*
+ * Upstream 7.x ubwc.h accessors, reimplemented on the 6.18 vendor
+ * struct qcom_ubwc_cfg_data (which carries the fields directly).
+ */
+static inline bool qcom_ubwc_min_acc_length_64b(const struct qcom_ubwc_cfg_data *cfg)
+{
+	return cfg->ubwc_enc_version == UBWC_1_0;
+}
+
+static inline bool qcom_ubwc_macrotile_mode(const struct qcom_ubwc_cfg_data *cfg)
+{
+	return cfg->macrotile_mode;
+}
+
+static inline bool qcom_ubwc_bank_spread(const struct qcom_ubwc_cfg_data *cfg)
+{
+	return cfg->ubwc_bank_spread;
+}
+
+static inline u32 qcom_ubwc_swizzle_618(const struct qcom_ubwc_cfg_data *cfg)
+{
+	return cfg->ubwc_swizzle;
+}
+#define qcom_ubwc_swizzle qcom_ubwc_swizzle_618
+
+#endif
