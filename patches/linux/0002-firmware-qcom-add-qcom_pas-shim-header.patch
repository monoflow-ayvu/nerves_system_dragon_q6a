firmware: qcom: add qcom_pas.h shim header for the 6.18 tree

The 7.x iris driver includes <linux/firmware/qcom/qcom_pas.h> and uses
the qcom_pas_* API, which only exists upstream with the dedicated PAS
driver. 6.18 exposes the same TrustZone calls through qcom_scm, so map
qcom_pas_auth_and_reset/shutdown/set_remote_state onto
qcom_scm_pas_auth_and_reset/qcom_scm_pas_shutdown/qcom_scm_set_remote_state.

diff --git a/include/linux/firmware/qcom/qcom_pas.h b/include/linux/firmware/qcom/qcom_pas.h
new file mode 100644
index 0000000..189ba96
--- /dev/null
+++ b/include/linux/firmware/qcom/qcom_pas.h
@@ -0,0 +1,23 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+/* Backport shim: 6.18 vendor tree lacks the qcom_pas driver; map onto qcom_scm. */
+#ifndef __QCOM_PAS_SHIM_H
+#define __QCOM_PAS_SHIM_H
+
+#include <linux/firmware/qcom/qcom_scm.h>
+
+static inline int qcom_pas_auth_and_reset(int peripheral)
+{
+	return qcom_scm_pas_auth_and_reset(peripheral);
+}
+
+static inline int qcom_pas_shutdown(int peripheral)
+{
+	return qcom_scm_pas_shutdown(peripheral);
+}
+
+static inline int qcom_pas_set_remote_state(u32 state, u32 id)
+{
+	return qcom_scm_set_remote_state(state, id);
+}
+
+#endif
