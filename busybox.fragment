# Extra Busybox applets on top of nerves-common busybox.config.
# qcom-coldplug.sh needs chmod/pidof; the rest are on-target debugging and
# general shell tools (read-only rootfs makes reinstalling tools painful —
# bake them in).
CONFIG_CHMOD=y
CONFIG_PIDOF=y
# POSIX `command` builtin for ash — nerves-common disables it, which made
# `command -v` probes in boot scripts fail silently.
CONFIG_ASH_CMDCMD=y
CONFIG_LSOF=y
CONFIG_TIME=y
CONFIG_TIMEOUT=y

# Text processing
CONFIG_HEAD=y
CONFIG_WC=y
CONFIG_SORT=y
CONFIG_FEATURE_SORT_BIG=y
CONFIG_UNIQ=y
CONFIG_CUT=y
CONFIG_TR=y
CONFIG_SED=y
CONFIG_AWK=y
CONFIG_FEATURE_AWK_LIBM=y
CONFIG_TEE=y
CONFIG_XARGS=y
CONFIG_FEATURE_XARGS_SUPPORT_CONFIRMATION=y
CONFIG_FEATURE_XARGS_SUPPORT_QUOTES=y
CONFIG_FEATURE_XARGS_SUPPORT_TERMOPT=y
CONFIG_FEATURE_XARGS_SUPPORT_ZERO_TERM=y
CONFIG_FEATURE_XARGS_SUPPORT_REPL_STR=y
CONFIG_DIFF=y
CONFIG_FEATURE_DIFF_LONG_OPTIONS=y
CONFIG_FEATURE_DIFF_DIR=y
CONFIG_PATCH=y
CONFIG_CMP=y
CONFIG_STRINGS=y
CONFIG_BASE64=y
CONFIG_EXPR=y
CONFIG_SEQ=y
CONFIG_MD5SUM=y
CONFIG_SHA1SUM=y

# File utilities
CONFIG_LN=y
CONFIG_TOUCH=y
CONFIG_SYNC=y
CONFIG_MKTEMP=y
CONFIG_INSTALL=y
CONFIG_TRUNCATE=y
CONFIG_WHICH=y
CONFIG_CLEAR=y
CONFIG_CHOWN=y
CONFIG_FEATURE_CHOWN_LONG_OPTIONS=y
CONFIG_CHGRP=y
CONFIG_BASENAME=y
CONFIG_DIRNAME=y
CONFIG_REALPATH=y
CONFIG_READLINK=y
CONFIG_FEATURE_READLINK_FOLLOW=y
CONFIG_STAT=y
CONFIG_FEATURE_STAT_FORMAT=y
CONFIG_FEATURE_STAT_FILESYSTEM=y

# Process/system
CONFIG_UNAME=y
CONFIG_HOSTNAME=y
CONFIG_UPTIME=y
CONFIG_TOP=y
CONFIG_FEATURE_TOP_CPU_USAGE_PERCENTAGE=y
CONFIG_FEATURE_TOP_CPU_GLOBAL_PERCENTS=y
CONFIG_FEATURE_TOP_SMP_CPU=y
CONFIG_FEATURE_TOP_DECIMALS=y
CONFIG_FEATURE_TOP_SMP_PROCESS=y
CONFIG_FEATURE_TOPMEM=y
CONFIG_DU=y
CONFIG_FEATURE_DU_DEFAULT_BLOCKSIZE_1K=y
CONFIG_WATCH=y
CONFIG_PGREP=y
CONFIG_PKILL=y
CONFIG_PSTREE=y
CONFIG_FUSER=y
CONFIG_NOHUP=y
CONFIG_NICE=y
CONFIG_VMSTAT=y
CONFIG_IOSTAT=y
CONFIG_MPSTAT=y
CONFIG_PMAP=y
CONFIG_STTY=y
CONFIG_HWCLOCK=y
CONFIG_POWERTOP=y
CONFIG_FEATURE_POWERTOP_INTERACTIVE=y

# Archives/compression (zstd unavailable in busybox 1.38)
CONFIG_TAR=y
CONFIG_FEATURE_TAR_CREATE=y
CONFIG_FEATURE_TAR_AUTODETECT=y
CONFIG_FEATURE_TAR_FROM=y
CONFIG_FEATURE_TAR_GNU_EXTENSIONS=y
CONFIG_FEATURE_TAR_LONG_OPTIONS=y
CONFIG_GZIP=y
CONFIG_FEATURE_GZIP_LONG_OPTIONS=y
CONFIG_GUNZIP=y
CONFIG_ZCAT=y
CONFIG_FEATURE_GZIP_DECOMPRESS=y
CONFIG_UNXZ=y
CONFIG_XZCAT=y
CONFIG_FEATURE_SEAMLESS_XZ=y

# Network
CONFIG_PING=y
CONFIG_PING6=y
CONFIG_FEATURE_FANCY_PING=y
CONFIG_TRACEROUTE=y
CONFIG_TRACEROUTE6=y
CONFIG_FEATURE_TRACEROUTE_VERBOSE=y
CONFIG_NSLOOKUP=y
CONFIG_NETSTAT=y
CONFIG_FEATURE_NETSTAT_WIDE=y
CONFIG_FEATURE_NETSTAT_PRG=y
CONFIG_NC=y
CONFIG_NC_SERVER=y
CONFIG_NC_EXTRA=y
CONFIG_WGET=y
CONFIG_FEATURE_WGET_STATUSBAR=y
CONFIG_FEATURE_WGET_AUTHENTICATION=y
CONFIG_FEATURE_WGET_LONG_OPTIONS=y
CONFIG_FEATURE_WGET_TIMEOUT=y
CONFIG_FEATURE_WGET_HTTPS=y
CONFIG_FEATURE_PREFER_IPV4_ADDRESS=y
CONFIG_VERBOSE_RESOLUTION_ERRORS=y

# Hardware debugging (bringup board)
CONFIG_I2CGET=y
CONFIG_I2CSET=y
CONFIG_I2CDETECT=y
CONFIG_I2CDUMP=y
CONFIG_I2CTRANSFER=y
CONFIG_LSUSB=y
CONFIG_LSPCI=y
CONFIG_DEVMEM=y
CONFIG_MICROCOM=y

# Editors/pagers
CONFIG_VI=y
CONFIG_FEATURE_VI_MAX_LEN=4096
CONFIG_FEATURE_VI_COLON=y
CONFIG_FEATURE_VI_YANKMARK=y
CONFIG_FEATURE_VI_SEARCH=y
CONFIG_FEATURE_VI_DOT_CMD=y
CONFIG_FEATURE_VI_SETOPTS=y
CONFIG_FEATURE_VI_SET=y
CONFIG_FEATURE_VI_UNDO=y
CONFIG_FEATURE_VI_8BIT=y
CONFIG_FEATURE_VI_WIN_RESIZE=y
CONFIG_FEATURE_VI_USE_SIGNALS=y
CONFIG_FEATURE_VI_VERBOSE_STATUS=y
CONFIG_LESS=y
CONFIG_FEATURE_LESS_REGEXP=y
CONFIG_FEATURE_LESS_WINCH=y
CONFIG_FEATURE_LESS_LINENUMS=y
CONFIG_FEATURE_LESS_FLAGS=y
CONFIG_FEATURE_LESS_MARKS=y
CONFIG_FEATURE_LESS_DASHCMD=y

# Misc debugging
CONFIG_TC=y
CONFIG_FEATURE_TC_INGRESS=y
CONFIG_INOTIFYD=y
CONFIG_RESIZE=y
CONFIG_FEATURE_FANCY_SLEEP=y

# Shell UX (ash): line editing, completion, persistent history (/root is the
# writable app-data partition), aliases, bash-isms.
CONFIG_FEATURE_EDITING=y
CONFIG_FEATURE_TAB_COMPLETION=y
CONFIG_FEATURE_EDITING_SAVEHISTORY=y
CONFIG_FEATURE_EDITING_HISTORY=1000
CONFIG_FEATURE_EDITING_FANCY_PROMPT=y
CONFIG_FEATURE_REVERSE_SEARCH=y
CONFIG_FEATURE_EDITING_WINCH=y
CONFIG_ASH_ALIAS=y
CONFIG_ASH_BASH_COMPAT=y
CONFIG_ASH_EXPAND_PRMT=y
CONFIG_ASH_GETOPTS=y
CONFIG_ASH_RANDOM_SUPPORT=y
