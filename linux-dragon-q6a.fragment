# Kernel config fragment applied on top of the arm64 arch defconfig
# (BR2_LINUX_KERNEL_USE_ARCH_DEFAULT_CONFIG). Two jobs:
#
#  1. Boot without initramfs: everything between reset and mounting the
#     squashfs root on SD/UFS must be built-in (=y), and the whole
#     FastRPC/remoteproc chain for the Hexagon NPU must be =y so no module
#     loading is needed before the CDSP comes up.
#  2. The same kernel must boot in QEMU (-M virt) for the smoke test, so
#     virtio is built-in too.
#
# Cross-checked against the task doc (§5), meta-qcom kernel configs and the
# RUBIK Pi 3 mainline porting guide (UFS m->y and friends).

# --- Core Qualcomm platform (sc7280/qcs6490 family) ---
CONFIG_ARCH_QCOM=y
CONFIG_QCOM_SCM=y
CONFIG_QCOM_COMMAND_DB=y
CONFIG_QCOM_RPMH=y
CONFIG_QCOM_RPMHPD=y
CONFIG_REGULATOR_QCOM_RPMH=y
CONFIG_QCOM_PDC=y
CONFIG_PINCTRL_SC7280=y
CONFIG_PINCTRL_QCOM_SPMI_PMIC=y
CONFIG_SC_GCC_7280=y
CONFIG_CLK_QCOM=y
CONFIG_QCOM_CLK_RPMH=y
CONFIG_QCOM_GDSC=y
CONFIG_INTERCONNECT=y
CONFIG_INTERCONNECT_QCOM=y
CONFIG_INTERCONNECT_QCOM_SC7280=y
CONFIG_QCOM_LLCC=y
CONFIG_QCOM_OCMEM=y
CONFIG_QCOM_AOSS_QMP=y
CONFIG_QCOM_QFPROM=y
CONFIG_NVMEM_QCOM_QFPROM=y
CONFIG_QCOM_SOCINFO=y
CONFIG_QCOM_STATS=y
CONFIG_QCOM_WDT=y
CONFIG_POWER_RESET_QCOM_PON=y
CONFIG_QCOM_TSENS=y
CONFIG_SPMI=y
CONFIG_SPMI_MSM_PMIC_ARB=y
CONFIG_MFD_SPMI_PMIC=y
CONFIG_ARM_SMMU=y
CONFIG_ARM_SMMU_QCOM=y

# --- Serial console (GENI SE UART -> ttyMSM0) ---
CONFIG_QCOM_GENI_SE=y
CONFIG_SERIAL_QCOM_GENI=y
CONFIG_SERIAL_QCOM_GENI_CONSOLE=y

# --- remoteproc / GLINK / FastRPC (the point of this system) ---
CONFIG_QCOM_SMEM=y
CONFIG_QCOM_SMP2P=y
CONFIG_QCOM_SMSM=y
CONFIG_HWSPINLOCK=y
CONFIG_HWSPINLOCK_QCOM=y
CONFIG_MAILBOX=y
CONFIG_QCOM_APCS_IPC=y
CONFIG_QCOM_IPCC=y
CONFIG_RPMSG=y
CONFIG_RPMSG_CHAR=y
CONFIG_RPMSG_CTRL=y
CONFIG_RPMSG_QCOM_GLINK=y
CONFIG_RPMSG_QCOM_GLINK_SMEM=y
CONFIG_RPMSG_QCOM_SMD=y
CONFIG_REMOTEPROC=y
CONFIG_QCOM_RPROC_COMMON=y
CONFIG_QCOM_PIL_INFO=y
CONFIG_QCOM_Q6V5_COMMON=y
CONFIG_QCOM_Q6V5_PAS=y
CONFIG_QCOM_SYSMON=y
CONFIG_QCOM_QMI_HELPERS=y
CONFIG_QCOM_PDR_HELPERS=y
# In-kernel protection-domain mapper (replaces the userspace pd-mapper
# daemon; required for adsp/cdsp bring-up on 6.11+).
CONFIG_QCOM_PD_MAPPER=y
CONFIG_QCOM_FASTRPC=y

# --- DMA-BUF heaps (FastRPC allocates from /dev/dma_heap/*) ---
CONFIG_DMABUF_HEAPS=y
CONFIG_DMABUF_HEAPS_SYSTEM=y
CONFIG_DMABUF_HEAPS_CMA=y
CONFIG_DMA_CMA=y
CONFIG_CMA=y
# FastRPC/QNN allocate DSP working buffers from the CMA dma_heap. Mainline
# sc7280 fastrpc has no shared-dma-pool carveout (unlike the downstream
# kernel behind the "no reserved DMA memory for FASTRPC" error-14001), so
# the global CMA pool must be generous. Overridable at boot with cma=.
CONFIG_CMA_SIZE_MBYTES=512

# --- Storage: boot without initramfs ---
# microSD (SDHCI MSM)
CONFIG_MMC=y
CONFIG_MMC_SDHCI=y
CONFIG_MMC_SDHCI_PLTFM=y
CONFIG_MMC_SDHCI_MSM=y
# UFS (on-board storage; RUBIK Pi guide flips these m->y)
CONFIG_SCSI=y
CONFIG_BLK_DEV_SD=y
CONFIG_SCSI_UFSHCD=y
CONFIG_SCSI_UFSHCD_PLATFORM=y
CONFIG_SCSI_UFS_QCOM=y
CONFIG_PHY_QCOM_QMP=y
CONFIG_PHY_QCOM_QMP_UFS=y

# --- Filesystems ---
CONFIG_SQUASHFS=y
CONFIG_SQUASHFS_XZ=y
CONFIG_SQUASHFS_ZSTD=y
CONFIG_SQUASHFS_GZIP=y
CONFIG_EXT4_FS=y
CONFIG_VFAT_FS=y
CONFIG_NLS_CODEPAGE_437=y
CONFIG_NLS_ISO8859_1=y

# --- EFI boot (GRUB hands off via the EFI stub) ---
CONFIG_EFI=y
CONFIG_EFI_STUB=y

# --- QEMU (-M virt) smoke test support ---
CONFIG_PCI=y
CONFIG_PCI_HOST_GENERIC=y
CONFIG_VIRTIO=y
CONFIG_VIRTIO_PCI=y
CONFIG_VIRTIO_MMIO=y
CONFIG_VIRTIO_BLK=y
CONFIG_VIRTIO_NET=y
CONFIG_VIRTIO_CONSOLE=y
CONFIG_HW_RANDOM_VIRTIO=y
CONFIG_SERIAL_AMBA_PL011=y
CONFIG_SERIAL_AMBA_PL011_CONSOLE=y
CONFIG_RTC_DRV_PL031=y

# --- Nerves runtime expectations ---
CONFIG_WATCHDOG=y
CONFIG_FW_LOADER=y
CONFIG_FW_LOADER_COMPRESS=y
CONFIG_FW_LOADER_COMPRESS_XZ=y
CONFIG_FW_LOADER_COMPRESS_ZSTD=y

# ============================================================
# Board peripherals (cross-checked against the pinned DTS,
# qcs6490-radxa-dragon-q6a.dts @ e05c4fa). Headless-critical
# hardware is =y; media/audio is =m (loaded by udev coldplug).
# ============================================================

# --- PCIe (pcie0: RTL8111 GbE, pcie1: M.2 NVMe) ---
CONFIG_PCIE_QCOM=y
CONFIG_PHY_QCOM_QMP_PCIE=y

# --- Ethernet: Realtek RTL8111 on pcie0 (arch defconfig has =m) ---
CONFIG_R8169=y

# --- NVMe on the M.2 M-key slot ---
CONFIG_BLK_DEV_NVME=y

# --- USB host: usb_1 (USB3 + DP combo phy), usb_2 (HS only; the
# --- onboard AIC8800D80 WiFi/BT module hangs off USB) ---
CONFIG_USB=y
CONFIG_USB_XHCI_HCD=y
CONFIG_USB_DWC3=y
CONFIG_USB_DWC3_QCOM=y
CONFIG_PHY_QCOM_USB_SNPS_FEMTO_V2=y
CONFIG_PHY_QCOM_QMP_COMBO=y
CONFIG_USB_STORAGE=y
CONFIG_USB_UAS=y
CONFIG_USB_HID=y
# USB network adapters (bench convenience)
CONFIG_USB_USBNET=m
CONFIG_USB_NET_CDCETHER=m
CONFIG_USB_NET_CDC_NCM=m
CONFIG_USB_RTL8152=m
CONFIG_USB_NET_AX88179_178A=m

# --- WiFi/BT: Aicsemi AIC8800D80 (USB). The DTS deletes the WCN6750
# --- wifi/wpss nodes; the vendor driver comes from package/aic8800
# --- (aic_load_fw + aic8800_fdrv + aic_btusb, fullmac cfg80211).
# --- Do NOT enable BT_HCIBTUSB: stock btusb would grab the AIC BT
# --- interface before aic_btusb.
CONFIG_CFG80211=m
CONFIG_RFKILL=y
CONFIG_BT=m
CONFIG_BT_RFCOMM=m

# --- GENI I2C/SPI/QSPI + GPI (GSI) DMA the board buses request ---
CONFIG_I2C_QCOM_GENI=y
CONFIG_SPI_QCOM_GENI=y
CONFIG_SPI_QCOM_QSPI=y
CONFIG_QCOM_GPI_DMA=y
# QSPI NOR flash (winbond w25q256jw)
CONFIG_MTD=y
CONFIG_MTD_SPI_NOR=y
CONFIG_MTD_BLOCK=y

# --- RTC (st,m41t11 @ i2c10), input, LEDs ---
CONFIG_RTC_DRV_M41T80=y
CONFIG_INPUT_PM8941_PWRKEY=y
CONFIG_KEYBOARD_GPIO=y
CONFIG_LEDS_GPIO=y
CONFIG_LEDS_TRIGGER_HEARTBEAT=y

# --- cpufreq / thermal / PMIC ADC (board thermal zones) ---
CONFIG_ARM_QCOM_CPUFREQ_HW=y
CONFIG_QCOM_LMH=y
CONFIG_QCOM_SPMI_ADC5=y
CONFIG_QCOM_SPMI_ADC_TM5=y
CONFIG_QCOM_SPMI_TEMP_ALARM=y

# --- QRTR: pin =y explicitly. QCOM_PD_MAPPER/QCOM_QMI_HELPERS (above,
# --- =y) depend on it; without this olddefconfig silently demotes the
# --- whole CDSP bring-up chain to =m.
CONFIG_QRTR=y
CONFIG_QRTR_SMD=y

# --- GPU / display (Adreno 643 + DP -> RA620 HDMI bridge), video,
# --- audio (AudioReach + WCD9380 codec). Modules: not boot-critical,
# --- probed via udev coldplug. Firmware from qcom-dsp-firmware.
CONFIG_DRM_MSM=m
CONFIG_DRM_SIMPLE_BRIDGE=m
CONFIG_DRM_DISPLAY_CONNECTOR=m
CONFIG_SC_DISPCC_7280=m
CONFIG_SC_GPUCC_7280=m
CONFIG_SC_LPASS_CORECC_7280=m
CONFIG_VIDEO_QCOM_VENUS=m
CONFIG_QCOM_APR=m
CONFIG_SOUNDWIRE=m
CONFIG_SOUNDWIRE_QCOM=m
CONFIG_SND_SOC_QCOM=m
CONFIG_SND_SOC_SC8280XP=m
CONFIG_SND_SOC_LPASS_RX_MACRO=m
CONFIG_SND_SOC_LPASS_TX_MACRO=m
CONFIG_SND_SOC_LPASS_VA_MACRO=m
CONFIG_SND_SOC_WCD938X=m
CONFIG_SND_SOC_WCD938X_SDW=m
CONFIG_PINCTRL_SC7280_LPASS_LPI=m
CONFIG_SND_USB_AUDIO=m
